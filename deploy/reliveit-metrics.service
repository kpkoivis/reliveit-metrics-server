[Unit]
Description=Reliveit metrics server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=reliveit-metrics
Group=reliveit-metrics
WorkingDirectory=/opt/reliveit-metrics
ExecStart=/opt/reliveit-metrics/MetricsServer
EnvironmentFile=/etc/reliveit-metrics.env
Restart=always
RestartSec=5

# The server only talks to Postgres and writes nothing to disk.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
