# Copy to /etc/reliveit-metrics.env, fill in, then: chmod 600 /etc/reliveit-metrics.env

# Where the server listens. nginx on the public host proxies data.kurkisoft.com to this
# address, so it is the LAN address rather than 127.0.0.1. Only nginx should be able to
# reach the port: sudo ufw allow from <nginx host's address> to any port 3020
ASPNETCORE_URLS=http://192.168.11.155:3020

ConnectionStrings__Metrics=Host=127.0.0.1;Database=metrics;Username=metrics;Password=change-me

# Must match MetricsConfig.ApiKey in the game (reliveit repo, Assets/Scripts/Metrics/MetricsConfig.cs).
Metrics__ApiKey=change-me

# How long gameplay statistics are kept, in months (default 24, as the privacy policy says).
# Older snapshots are deleted daily and old purchase rows lose their install id, game and age;
# the sales records themselves are kept. 0 keeps everything forever.
# Metrics__StatisticsRetentionMonths=24
